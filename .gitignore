# User-supplied materials and generated state must never be committed.
local-input/
project_liminal_gate.egg-info/
user-data/
# Temporary extraction output, including native binaries pulled from a local
# APK. Never publishable.
work/
state/
logs/*
!logs/tooling.md
build/
dist/
*.apk
*.ipa
*.zip
*.7z
*.bin
*.key
*.pem
*.p12
*.jsonl
# Resource manifests travel beside the .bin payloads above but do not match
# *.bin, and the per-category catalogs have no extension at all. The paths
# above cover the documented layout; these cover an archive unpacked anywhere
# else.
*.manifest
**/BG/BG
**/BGM/BGM
**/Banner/Banner
**/BuddyImages/BuddyImages
**/BuddyThumbs/BuddyThumbs
**/Illust/Illust
**/Pieces/Pieces
**/SE/SE
**/Scenario/Scenario
__pycache__/
*.py[cod]
.DS_Store
